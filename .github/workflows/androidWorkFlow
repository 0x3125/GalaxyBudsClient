name: Compile Android binaries

on:
  push:
    branches: [ master ]
  pull_request:
    branches: [ master ]
  workflow_dispatch:

jobs:
  build-android:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up .NET
        uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json

      - name: Install Android workload
        run: dotnet workload install android

      - name: Restore
        run: dotnet restore GalaxyBudsClient.Android/GalaxyBudsClient.Android.csproj --configfile GalaxyBudsClient/nuget.config

      - name: Publish APK (Release)
        run: |
          dotnet publish GalaxyBudsClient.Android/GalaxyBudsClient.Android.csproj \
            -c Release \
            -p:AndroidPackageFormat=apk \
            --no-restore \
            -o bin_android

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: GalaxyBudsClient-Android
          path: |
            bin_android/*-Signed.apk
            bin_android/*.apk
            bin_android/*.aab
          if-no-files-found: warn
